-- ---
-- ## Parte 0: Implementaciones Personalizadas
-- ---

-- 1. Map Personalizado
miMap : (a -> b) -> List a -> List b
miMap f lista =
    case lista of
        [] ->
            []

        x :: xs ->
            f x :: miMap f xs


-- 2. Filter Personalizado
miFiltro : (a -> Bool) -> List a -> List a
miFiltro f lista =
    case lista of
        [] ->
            []

        x :: xs ->
            if f x then
                x :: miFiltro f xs
            else
                miFiltro f xs


-- 3. Foldl Personalizado
miFoldl : (a -> b -> b) -> b -> List a -> b
miFoldl f acc lista =
    case lista of
        [] ->
            acc

        x :: xs ->
            miFoldl f (f x acc) xs


