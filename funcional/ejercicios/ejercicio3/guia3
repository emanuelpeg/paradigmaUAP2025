-- 30. Agrupar Por
-- (Esta usa foldr para agrupar desde el final)
agruparPor : (a -> a -> Bool) -> List a -> List (List a)
agruparPor sonIguales lista =
    let
        funcionFold elem acc =
            case acc of
                [] ->
                    -- Si el acumulador está vacío, este es el primer grupo
                    [[elem]]

                primerGrupo :: restoDeGrupos ->
                    -- Revisamos el primer elemento del primer grupo
                    case List.head primerGrupo of
                        Nothing ->
                            -- No debería pasar, pero por si acaso
                            [[elem]]

                        Just primerElemento ->
                            if sonIguales elem primerElemento then
                                -- Si es igual, lo agregamos al primer grupo
                                (elem :: primerGrupo) :: restoDeGrupos
                            else
                                -- Si es diferente, creamos un nuevo grupo
                                [elem] :: acc
    in
    List.foldr funcionFold [] lista


-- 31. Particionar
particionar : (a -> Bool) -> List a -> (List a, List a)
particionar f lista =
    let
        funcionFold elem (trues, falses) =
            if f elem then
                (elem :: trues, falses)
            else
                (trues, elem :: falses)
    in
    -- Usamos foldr para mantener el orden original en las sublistas
    List.foldr funcionFold ([], []) lista


-- 32. Suma Acumulada
sumaAcumulada : List Int -> List Int
sumaAcumulada lista =
    let
        -- El acumulador es (sumaParcial, listaAcumuladaAlReves)
        ( sumaFinal, listaAlReves ) =
            List.foldl
                (\elem (sumaParcial, accLista) ->
                    let
                        nuevaSuma =
                            sumaParcial + elem
                    in
                    ( nuevaSuma, nuevaSuma :: accLista )
                )
                ( 0, [] )
                lista
    in
    -- Damos vuelta la lista acumulada para el resultado final
    List.reverse listaAlReves


-- ---
-- ## Subconjuntos
-- ---

subSets : List Int -> List (List Int)
subSets lista =
    case lista of
        [] ->
            -- El único subconjunto de [] es []
            [[]]

        x :: xs ->
            let
                -- 1. Obtenemos los subconjuntos del resto de la lista
                subsDeXs =
                    subSets xs

                -- 2. Creamos una nueva lista con 'x' agregado a cada uno
                conX =
                    List.map (\sub -> x :: sub) subsDeXs
            in
            -- 3. El resultado es la unión de ambos
            subsDeXs ++ conX


-- ---
-- ## Dividir en Grupos
-- ---

tomar : Int -> List a -> List a
tomar n lista =
    List.take n lista


saltar : Int -> List a -> List a
saltar n lista =
    List.drop n lista


cortar : List Int -> Int -> List (List Int)
cortar lista n =
    if List.isEmpty lista then
        []
    else
        let
            primerGrupo =
                tomar n lista

            resto =
                saltar n lista
        in
        primerGrupo :: cortar resto n


