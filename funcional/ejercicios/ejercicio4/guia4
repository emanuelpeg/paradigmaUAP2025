-- 19. Validar No Vacío
validarNoVacio : Tree a -> Result String (Tree a)
validarNoVacio arbol =
    case arbol of
        Empty ->
            Err "El árbol está vacío"

        _ ->
            Ok arbol


-- 20. Obtener Raíz con Error
obtenerRaiz : Tree a -> Result String a
obtenerRaiz arbol =
    case arbol of
        Empty ->
            Err "No se puede obtener la raíz de un árbol vacío"

        Node valor _ _ ->
            Ok valor


-- 21. Dividir en Valor Raíz y Subárboles
dividir : Tree a -> Result String (a, Tree a, Tree a)
dividir arbol =
    case arbol of
        Empty ->
            Err "No se puede dividir un árbol vacío"

        Node valor izquierdo derecho ->
            Ok ( valor, izquierdo, derecho )


-- 22. Obtener Mínimo con Error
obtenerMinimo : Tree comparable -> Result String comparable
obtenerMinimo arbol =
    case encontrarMinimo arbol of
        Nothing ->
            Err "No hay mínimo en un árbol vacío"

        Just minVal ->
            Ok minVal


-- 23. Verificar si es BST
esBST : Tree comparable -> Bool
esBST arbol =
    esBSTAux Nothing Nothing arbol


-- Función auxiliar para esBST que lleva los límites
esBSTAux : Maybe comparable -> Maybe comparable -> Tree comparable -> Bool
esBSTAux minBound maxBound arbol =
    case arbol of
        Empty ->
            True

        Node valor izquierdo derecho ->
            let
                -- Verifica que el valor esté dentro de los límites heredados
                esRaizValida =
                    (case minBound of
                        Just minB ->
                            valor > minB

                        Nothing ->
                            True
                    )
                        && (case maxBound of
                                Just maxB ->
                                    valor < maxB

                                Nothing ->
                                    True
                           )
            in
            esRaizValida
                -- El subárbol izquierdo debe ser menor que 'valor'
                && esBSTAux minBound (Just valor) izquierdo
                -- El subárbol derecho debe ser mayor que 'valor'
                && esBSTAux (Just valor) maxBound derecho


-- 24. Insertar en BST
insertarBST : comparable -> Tree comparable -> Result String (Tree comparable)
insertarBST valor arbol =
    case arbol of
        Empty ->
            Ok (Node valor Empty Empty)

        Node v i d ->
            if valor == v then
                Err "El valor ya existe en el árbol"

            else if valor < v then
                -- Inserta a la izquierda y "reconstruye" el nodo
                insertarBST valor i
                    |> Result.map (\nuevoI -> Node v nuevoI d)

            else
                -- Inserta a la derecha y "reconstruye" el nodo
                insertarBST valor d
                    |> Result.map (\nuevoD -> Node v i nuevoD)


-- 25. Buscar en BST
buscarEnBST : comparable -> Tree comparable -> Result String comparable
buscarEnBST valorBuscado arbol =
    case arbol of
        Empty ->
            Err ("El valor " ++ String.fromInt (valorBuscado) ++ " no se encuentra en el árbol")

        Node v i d ->
            if valorBuscado == v then
                Ok v

            else if valorBuscado < v then
                buscarEnBST valorBuscado i

            else
                buscarEnBST valorBuscado d


-- 26. Validar BST con Result
validarBST : Tree comparable -> Result String (Tree comparable)
validarBST arbol =
    validarBSTAux Nothing Nothing arbol
        |> Result.map (\_ -> arbol)


-- Auxiliar que retorna un Result con error descriptivo
validarBSTAux : Maybe comparable -> Maybe comparable -> Tree comparable -> Result String ()
validarBSTAux minBound maxBound arbol =
    case arbol of
        Empty ->
            Ok ()

        Node v i d ->
            let
                raizValida =
                    case ( minBound, maxBound ) of
                        ( Just minB, _ ) ->
                            if v > minB then
                                Ok ()
                            else
                                Err ("Nodo con valor viola la propiedad BST: debe ser mayor que su ancestro")

                        ( _, Just maxB ) ->
                            if v < maxB then
                                Ok ()
                            else
                                Err ("Nodo con valor viola la propiedad BST: debe ser menor que su ancestro")

                        _ ->
                            Ok ()
            in
            raizValida
                |> Result.andThen (\_ -> validarBSTAux minBound (Just v) i)
                |> Result.andThen (\_ -> validarBSTAux (Just v) maxBound d)


