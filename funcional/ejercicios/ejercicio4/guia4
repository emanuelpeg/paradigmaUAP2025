-- 32. Recorrido Inorder
inorder : Tree a -> List a
inorder arbol =
    case arbol of
        Empty ->
            []

        Node v i d ->
            (inorder i) ++ [ v ] ++ (inorder d)


-- 33. Recorrido Preorder
preorder : Tree a -> List a
preorder arbol =
    case arbol of
        Empty ->
            []

        Node v i d ->
            [ v ] ++ (preorder i) ++ (preorder d)


-- 34. Recorrido Postorder
postorder : Tree a -> List a
postorder arbol =
    case arbol of
        Empty ->
            []

        Node v i d ->
            (postorder i) ++ (postorder d) ++ [ v ]


-- 35. Map sobre Árbol
mapArbol : (a -> b) -> Tree a -> Tree b
mapArbol f arbol =
    case arbol of
        Empty ->
            Empty

        Node v i d ->
            Node (f v) (mapArbol f i) (mapArbol f d)


-- 36. Filter sobre Árbol
filterArbol : (a -> Bool) -> Tree a -> Tree a
filterArbol f arbol =
    case arbol of
        Empty ->
            Empty

        Node v i d ->
            if f v then
                -- Si el nodo pasa, mantiene su estructura
                Node v (filterArbol f i) (filterArbol f d)
            else
                -- Si el nodo falla, se elimina (y con él sus hijos)
                -- Esto es basado en el ejemplo de la guía.
                Empty


-- 37. Fold sobre Árbol
foldArbol : (a -> b -> b) -> b -> Tree a -> b
foldArbol f acc arbol =
    -- Implementación inorder (izquierda, raíz, derecha)
    case arbol of
        Empty ->
            acc

        Node v i d ->
            let
                -- 1. Procesa izquierda
                accIzquierda =
                    foldArbol f acc i

                -- 2. Procesa raíz
                accRaiz =
                    f v accIzquierda

                -- 3. Procesa derecha
                accDerecha =
                    foldArbol f accRaiz d
            in
            accDerecha


-- 38. Eliminar de BST

-- Primero, una función auxiliar para encontrar y extraer el mínimo de un subárbol
-- Retorna (ValorMínimo, ÁrbolRestante)
extraerMinimo : Tree comparable -> Result String ( comparable, Tree comparable )
extraerMinimo arbol =
    case arbol of
        Empty ->
            Err "Subárbol vacío, no se puede extraer mínimo (esto no debería pasar)"

        Node v Empty d ->
            -- Este es el nodo mínimo, retornamos su valor y su hijo derecho
            Ok ( v, d )

        Node v i d ->
            -- El mínimo está a la izquierda, seguimos buscando
            extraerMinimo i
                |> Result.map (\( minVal, nuevoI ) -> ( minVal, Node v nuevoI d ))


eliminarBST : comparable -> Tree comparable -> Result String (Tree comparable)
eliminarBST valor arbol =
    case arbol of
        Empty ->
            Err "El valor no existe en el árbol"

        Node v i d ->
            if valor < v then
                -- Está a la izquierda
                eliminarBST valor i
                    |> Result.map (\nuevoI -> Node v nuevoI d)

            else if valor > v then
                -- Está a la derecha
                eliminarBST valor d
                    |> Result.map (\nuevoD -> Node v i nuevoD)

            else
                -- Encontramos el nodo a eliminar (v == valor)
                case ( i, d ) of
                    ( Empty, Empty ) -> Ok Empty -- 0. Es hoja
                    ( _, Empty ) -> Ok i -- 1. Solo hijo izquierdo
                    ( Empty, _ ) -> Ok d -- 2. Solo hijo derecho
                    ( _, _ ) ->
                        -- 3. Tiene dos hijos
                        -- Extraemos el sucesor (mínimo del subárbol derecho)
                        case extraerMinimo d of
                            Err msg ->
                                Err msg

                            Ok ( sucesor, nuevoD ) ->
                                -- Reemplazamos el valor del nodo actual
                                -- con el sucesor y usamos el subárbol derecho modificado
                                Ok (Node sucesor i nuevoD)


-- 39. Construir BST desde Lista
desdeListaBST : List comparable -> Result String (Tree comparable)
desdeListaBST lista =
    List.foldl
        (\elem accTreeResult ->
            accTreeResult
                |> Result.andThen (\accTree -> insertarBST elem accTree)
        )
        (Ok Empty)
        lista


-- 40. Verificar Balance
estaBalanceado : Tree a -> Bool
estaBalanceado arbol =
    case arbol of
        Empty ->
            True

        Node _ i d ->
            (abs (altura i - altura d) <= 1)
                && estaBalanceado i
                && estaBalanceado d


-- 41. Balancear BST
balancear : Tree comparable -> Tree comparable
balancear arbol =
    arbol
        |> inorder
        |> construirBalanceadoDesdeLista


-- Auxiliar para balancear: construye un BST balanceado desde una lista ordenada
construirBalanceadoDesdeLista : List comparable -> Tree comparable
construirBalanceadoDesdeLista lista =
    case lista of
        [] ->
            Empty

        _ ->
            let
                n =
                    List.length lista

                medioIdx =
                    n // 2

                ( izquierda, resto ) =
                    List.splitAt medioIdx lista
            in
            case resto of
                [] ->
                    -- No debería pasar si la lista no es vacía
                    Empty

                raizVal :: derecha ->
                    Node raizVal
                        (construirBalanceadoDesdeLista izquierda)
                        (construirBalanceadoDesdeLista derecha)


-- 42. Camino a un Valor
type Direccion
    = Izquierda
    | Derecha


encontrarCamino : comparable -> Tree comparable -> Result String (List Direccion)
encontrarCamino valorBuscado arbol =
    case arbol of
        Empty ->
            Err "El valor no existe en el árbol"

        Node v i d ->
            if valorBuscado == v then
                Ok []

            else if valorBuscado < v then
                encontrarCamino valorBuscado i
                    |> Result.map (\camino -> Izquierda :: camino)

            else
                encontrarCamino valorBuscado d
                    |> Result.map (\camino -> Derecha :: camino)


-- 43. Seguir Camino
seguirCamino : List Direccion -> Tree a -> Result String a
seguirCamino camino arbol =
    case ( camino, arbol ) of
        ( [], Node v _ _ ) ->
            Ok v

        ( Izquierda :: cs, Node _ i _ ) ->
            seguirCamino cs i

        ( Derecha :: cs, Node _ _ d ) ->
            seguirCamino cs d

        ( _, Empty ) ->
            Err "Camino inválido: se llegó a un árbol vacío"

        ( [], Empty ) ->
            Err "Camino inválido: se llegó a un árbol vacío"


-- 44. Ancestro Común Más Cercano
ancestroComun : comparable -> comparable -> Tree comparable -> Result String comparable
ancestroComun val1 val2 arbol =
    case arbol of
        Empty ->
            Err "Árbol vacío o valores no encontrados"

        Node v i d ->
            if val1 < v && val2 < v then
                -- Ambos están a la izquierda
                ancestroComun val1 val2 i

            else if val1 > v && val2 > v then
                -- Ambos están a la derecha
                ancestroComun val1 val2 d

            else
                -- El nodo actual es el punto de división, o uno de los valores
                Ok v

