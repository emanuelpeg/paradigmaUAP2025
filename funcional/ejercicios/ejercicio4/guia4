-- 27. Maybe a Result
maybeAResult : String -> Maybe a -> Result String a
maybeAResult errorMsg maybeVal =
    case maybeVal of
        Nothing ->
            Err errorMsg

        Just valor ->
            Ok valor


-- 28. Result a Maybe
resultAMaybe : Result error value -> Maybe value
resultAMaybe resultVal =
    case resultVal of
        Err _ ->
            Nothing

        Ok valor ->
            Just valor


-- 29. Buscar y Validar
buscarPositivo : Int -> Tree Int -> Result String Int
buscarPositivo valor arbol =
    -- Usamos 'buscar' genérico, no 'buscarEnBST'
    buscar valor arbol
        |> maybeAResult ("El valor " ++ String.fromInt valor ++ " no se encuentra en el árbol")
        |> Result.andThen
            (\encontrado ->
                if encontrado > 0 then
                    Ok encontrado
                else
                    Err ("El valor " ++ String.fromInt encontrado ++ " no es positivo")
            )


-- 30. Pipeline de Validaciones
todosPositivos : Tree Int -> Bool
todosPositivos t =
    case t of
        Empty ->
            True

        Node v i d ->
            (v > 0) && todosPositivos i && todosPositivos d


validarArbol : Tree Int -> Result String (Tree Int)
validarArbol arbol =
    arbol
        |> validarNoVacio
        |> Result.andThen validarBST
        |> Result.andThen
            (\bstArbol ->
                if todosPositivos bstArbol then
                    Ok bstArbol
                else
                    Err "El árbol contiene valores no positivos"
            )


-- 31. Encadenar Búsquedas
buscarEnDosArboles : Int -> Tree Int -> Tree Int -> Result String Int
buscarEnDosArboles valor arbol1 arbol2 =
    buscarEnBST valor arbol1
        |> Result.andThen (\resultado1 -> buscarEnBST resultado1 arbol2)


