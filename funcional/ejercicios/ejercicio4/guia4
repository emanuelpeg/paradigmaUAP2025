-- 11. Buscar Valor
buscar : comparable -> Tree comparable -> Maybe comparable
buscar valorBuscado arbol =
    case arbol of
        Empty ->
            Nothing

        Node valor izquierdo derecho ->
            if valor == valorBuscado then
                Just valor
            else
                case buscar valorBuscado izquierdo of
                    Just encontrado ->
                        Just encontrado

                    Nothing ->
                        buscar valorBuscado derecho


-- 12. Encontrar Mínimo (con Maybe)
encontrarMinimo : Tree comparable -> Maybe comparable
encontrarMinimo arbol =
    case arbol of
        Empty ->
            Nothing

        Node valor izquierdo derecho ->
            let
                minSubarboles =
                    case ( encontrarMinimo izquierdo, encontrarMinimo derecho ) of
                        ( Just minI, Just minD ) -> Just (min minI minD)
                        ( Just minI, Nothing ) -> Just minI
                        ( Nothing, Just minD ) -> Just minD
                        ( Nothing, Nothing ) -> Nothing
            in
            case minSubarboles of
                Just minSub ->
                    Just (min valor minSub)

                Nothing ->
                    Just valor


-- 13. Encontrar Máximo (con Maybe)
encontrarMaximo : Tree comparable -> Maybe comparable
encontrarMaximo arbol =
    case arbol of
        Empty ->
            Nothing

        Node valor izquierdo derecho ->
            let
                maxSubarboles =
                    case ( encontrarMaximo izquierdo, encontrarMaximo derecho ) of
                        ( Just maxI, Just maxD ) -> Just (max maxI maxD)
                        ( Just maxI, Nothing ) -> Just maxI
                        ( Nothing, Just maxD ) -> Just maxD
                        ( Nothing, Nothing ) -> Nothing
            in
            case maxSubarboles of
                Just maxSub ->
                    Just (max valor maxSub)

                Nothing ->
                    Just valor


-- 14. Buscar Por Predicado
buscarPor : (a -> Bool) -> Tree a -> Maybe a
buscarPor predicado arbol =
    case arbol of
        Empty ->
            Nothing

        Node valor izquierdo derecho ->
            if predicado valor then
                Just valor
            else
                case buscarPor predicado izquierdo of
                    Just encontrado ->
                        Just encontrado

                    Nothing ->
                        buscarPor predicado derecho


-- 15. Obtener Valor de Raíz
raiz : Tree a -> Maybe a
raiz arbol =
    case arbol of
        Empty ->
            Nothing

        Node valor _ _ ->
            Just valor


-- 16. Obtener Hijo Izquierdo
hijoIzquierdo : Tree a -> Maybe (Tree a)
hijoIzquierdo arbol =
    case arbol of
        Empty ->
            Nothing

        Node _ izquierdo _ ->
            Just izquierdo


hijoDerecho : Tree a -> Maybe (Tree a)
hijoDerecho arbol =
    case arbol of
        Empty ->
            Nothing

        Node _ _ derecho ->
            Just derecho


-- 17. Obtener Nieto
nietoIzquierdoIzquierdo : Tree a -> Maybe (Tree a)
nietoIzquierdoIzquierdo arbol =
    arbol
        |> Maybe.andThen hijoIzquierdo
        |> Maybe.andThen hijoIzquierdo


-- 18. Buscar en Profundidad

obtenerSubarbol : comparable -> Tree comparable -> Maybe (Tree comparable)
obtenerSubarbol valorBuscado arbol =
    case arbol of
        Empty ->
            Nothing

        Node valor _ _ ->
            if valor == valorBuscado then
                Just arbol
            else
                case obtenerSubarbol valorBuscado (hijoIzquierdo arbol |> Maybe.withDefault Empty) of
                    Just encontrado ->
                        Just encontrado

                    Nothing ->
                        obtenerSubarbol valorBuscado (hijoDerecho arbol |> Maybe.withDefault Empty)


buscarEnSubarbol : comparable -> comparable -> Tree comparable -> Maybe comparable
buscarEnSubarbol valor1 valor2 arbol =
    arbol
        |> obtenerSubarbol valor1
        |> Maybe.andThen (buscar valor2)


